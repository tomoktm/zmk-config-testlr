#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q   &kp W   &kp I     &kp O
                &kp A   &lt 1 S   &kp K     &kp L
            >;
        };
        bt_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &trans &trans
                &bt BT_CLR   &mo 0 &trans &trans
            >;
        };
    };
};

